{
  "name": "arcane-sentinel",
  "private": true,
  "version": "0.7.0",
  "description": "Grimhold — tower defense roguelike.",
  "author": "Marcos Antonio Lisboa Junior",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "dev:demo": "vite --mode demo",
    "lint": "eslint .",
    "test": "node scripts/testar.mjs",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:demo": "npm run build:demo && electron-builder --config electron-builder.demo.cjs",
    "electron:pack:demo": "npm run build:demo && electron-builder --config electron-builder.demo.cjs --win --dir",
    "zip:demo": "node scripts/make-steam-zip.cjs",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "i18n:leaks": "node scripts/i18n-leaks.mjs",
    "i18n:verify": "node scripts/i18n-verify.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "i18n:migrate:bestiary": "node scripts/i18n-bestiary-migrate.mjs",
    "i18n:migrate:skilltrees": "node scripts/i18n-skilltrees-migrate.mjs",
    "i18n:migrate:compendium": "node scripts/i18n-compendium-migrate.mjs",
    "i18n:migrate:allies": "node scripts/i18n-allies-migrate.mjs",
    "i18n:migrate:relics": "node scripts/i18n-relics-migrate.mjs",
    "i18n:migrate:synergies": "node scripts/i18n-synergies-migrate.mjs",
    "i18n:migrate:achievements": "node scripts/i18n-achievements-migrate.mjs",
    "i18n:migrate:account": "node scripts/i18n-account-migrate.mjs",
    "i18n:migrate:shoppools": "node scripts/i18n-shoppools-migrate.mjs",
    "i18n:migrate:battlepass": "node scripts/i18n-battlepass-migrate.mjs",
    "i18n:migrate:endings": "node scripts/i18n-endings-migrate.mjs",
    "i18n:migrate:runhistory": "node scripts/i18n-runhistory-migrate.mjs",
    "i18n:migrate:skilltreepanel": "node scripts/i18n-skilltreepanel-migrate.mjs",
    "i18n:migrate:wavesummary": "node scripts/i18n-wavesummary-migrate.mjs",
    "i18n:migrate:resto": "node scripts/i18n-resto-dados-migrate.mjs",
    "i18n:migrate:lore": "node scripts/i18n-lore-migrate.mjs",
    "i18n:titles-keys": "node scripts/i18n-titles-keys.mjs",
    "i18n:lore-keys": "node scripts/i18n-lore-keys.mjs",
    "i18n:gc:settings": "node scripts/i18n-gamecanvas-settings.mjs",
    "i18n:gc:bestiary": "node scripts/i18n-gamecanvas-bestiary.mjs",
    "i18n:gc:menu": "node scripts/i18n-gamecanvas-menu.mjs",
    "i18n:gc:splash": "node scripts/i18n-gamecanvas-splash.mjs",
    "i18n:gc:credits": "node scripts/i18n-gamecanvas-credits.mjs",
    "i18n:gc:synergies": "node scripts/i18n-gamecanvas-synergies.mjs",
    "i18n:gc:achievements": "node scripts/i18n-gamecanvas-achievements.mjs",
    "i18n:gc:grimoire": "node scripts/i18n-gamecanvas-grimoire.mjs",
    "i18n:gc:heroshop": "node scripts/i18n-gamecanvas-heroshop.mjs",
    "i18n:gc:charselect": "node scripts/i18n-gamecanvas-charselect.mjs",
    "i18n:gc:chartabs": "node scripts/i18n-gamecanvas-chartabs.mjs",
    "i18n:gc:relictab": "node scripts/i18n-gamecanvas-relictab.mjs",
    "i18n:gc:pause": "node scripts/i18n-gamecanvas-pause.mjs",
    "i18n:gc:shop": "node scripts/i18n-gamecanvas-shop.mjs",
    "i18n:gc:tutorial": "node scripts/i18n-gamecanvas-tutorial.mjs",
    "i18n:gc:trans": "node scripts/i18n-gamecanvas-trans.mjs",
    "i18n:gc:hud": "node scripts/i18n-gamecanvas-hud.mjs",
    "i18n:gc:cards": "node scripts/i18n-gamecanvas-cards.mjs",
    "i18n:gc:cards2": "node scripts/i18n-gamecanvas-cards2.mjs",
    "i18n:gc:endrun": "node scripts/i18n-gamecanvas-endrun.mjs",
    "i18n:gc:bosstoasts": "node scripts/i18n-gamecanvas-bosstoasts.mjs",
    "fonts:pixel": "node scripts/fonts-local.mjs pixel",
    "fonts:cjk": "node scripts/fonts-cjk.mjs",
    "fonts:cjk-stack": "node scripts/fonts-cjk-stack.mjs",
    "fonts:local": "node scripts/fonts-local.mjs"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "i18next": "^26.4.1",
    "lucide-react": "^0.562.0",
    "playwright": "^1.63.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.13",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.2.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.grimhold.game",
    "productName": "Grimhold",
    "icon": "build/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/steamworks.js/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "icon": "build/icons"
    }
  }
}
